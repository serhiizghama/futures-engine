# Service Configuration
SERVICE_NAME=position-processor

# Kafka Configuration
KAFKA_BROKERS=localhost:9092

# Redis Configuration
REDIS_URL=redis://localhost:6379

# PostgreSQL Configuration
PGHOST=localhost
PGPORT=5432
PGUSER=futures
PGPASSWORD=futures
PGDATABASE=futures

# Alternative: Use DATABASE_URL instead of individual PG* vars
# DATABASE_URL=postgresql://futures:futures@localhost:5432/futures
