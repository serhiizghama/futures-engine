# Dependencies (exclude node_modules but keep package files)
node_modules
**/node_modules
npm-debug.log
yarn-error.log

# Build output (will be rebuilt in Docker)
dist
**/dist
build
**/build

# Environment files
.env
.env.local
.env.*.local

# IDE
.vscode
.idea
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Git
.git
.gitignore

# Docker files (except Dockerfiles which are referenced directly)
docker-compose*.yml
.dockerignore

# Documentation 
docs

# Tests (not needed for production builds)
**/*.test.ts
**/*.spec.ts
test
tests

# Linting configs (not needed for runtime)
.eslintrc*
.prettierrc*
